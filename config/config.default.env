# worktree-devcontainer configuration. Edit the copied config.env in Herdr's plugin config directory.

# Master switch. 0 disables every event hook and action.
WTDC_ENABLED=1

# What to do when a worktree is created and it has a devcontainer config.
#   prompt  ask first, in a plugin overlay            (default)
#   auto    build the container without asking
#   never   do nothing
WTDC_ON_CREATE=prompt

# Show a Herdr notification when the build finishes or fails. A first build is
# minutes long and there is no other signal that it is done.
WTDC_NOTIFY=1

# Seconds to wait for the readiness marker that postCreateCommand writes.
WTDC_BUILD_TIMEOUT=1800

# Keep the container when the worktree is removed. 0 destroys it.
WTDC_KEEP_CONTAINER=0

# Open a container-backed tab when the build finishes. 0 only marks the
# worktree; every terminal you open yourself still enters the container once
# the shell dispatcher is installed.
WTDC_OPEN_CONTAINER_PANE=1

# Prefix the worktree's sidebar label with this, so a containerised worktree
# is recognisable at a glance. Empty disables the marker.
WTDC_CONTAINER_ICON='🐳'

# Extra bind mounts for `devcontainer up`, space separated, e.g.
#   WTDC_EXTRA_MOUNTS='type=bind,source=/tmp/x,target=/tmp/x'
WTDC_EXTRA_MOUNTS=

# Paths searched for a devcontainer config, relative to the worktree.
WTDC_CONFIG_CANDIDATES='.devcontainer/devcontainer.json .devcontainer.json'

# Run a prebuilt image instead of building one. Either name a template from
# images/manifest.json, or point straight at an image. When set, the plugin
# does not inject any features, so the devcontainer CLI has none to apply and
# never derives a per-workspace image: `up` is just `docker run`.
#   WTDC_TEMPLATE=node
#   WTDC_IMAGE=ghcr.io/me/my-image:tag
WTDC_TEMPLATE=
WTDC_IMAGE=

# remoteUser for prebuilt images. The templates ship a `dev` user.
WTDC_IMAGE_REMOTE_USER=dev

# Reuse the host herdr binary instead of downloading one per container.
# Linux hosts only. Mounts a cache copy, never the live binary.
WTDC_SHARE_HERDR_BIN=auto
