# worktree-devcontainer configuration. Edit the copied config.env in Herdr's plugin config directory.

# Master switch. 0 disables every event hook and action.
WTDC_ENABLED=1

# What to do when a worktree is created and it has a devcontainer config.
#   prompt  ask first, in a plugin overlay            (default)
#   auto    build the container without asking
#   never   do nothing
WTDC_ON_CREATE=prompt

# Show a Herdr notification when the build finishes or fails. A first build is
# minutes long and there is no other signal that it is done.
WTDC_NOTIFY=1

# Seconds to wait for the readiness marker that postCreateCommand writes.
WTDC_BUILD_TIMEOUT=1800

# Keep the container when the worktree is removed. 0 destroys it.
WTDC_KEEP_CONTAINER=0

# Open a container-backed tab when the build finishes. 0 only marks the
# worktree; every terminal you open yourself still enters the container once
# the shell dispatcher is installed.
WTDC_OPEN_CONTAINER_PANE=1

# What to call the container, which is what the shell prompt shows after the @.
#   branch  its git branch, folded into a legal hostname  (default)
#   off     nothing, so the prompt shows the container id
# Or set a literal hostname. A --hostname in the repo's own runArgs always wins,
# and the hostname is fixed when the container is created, so changing this
# applies to the next provision, not to a container that is already running.
WTDC_HOSTNAME=branch

# Prefix the worktree's sidebar label with this, so a containerised worktree
# is recognisable at a glance. Empty disables the marker.
WTDC_CONTAINER_ICON='🐳'

# Extra bind mounts for `devcontainer up`, space separated, e.g.
#   WTDC_EXTRA_MOUNTS='type=bind,source=/tmp/x,target=/tmp/x'
WTDC_EXTRA_MOUNTS=

# Paths searched for a devcontainer config, relative to whichever directory
# WTDC_CONFIG_SOURCE names below.
WTDC_CONFIG_CANDIDATES='.devcontainer/devcontainer.json .devcontainer.json'

# Where that search starts. `main` (the default) looks in the repository's main
# checkout — the one you edit — and falls back to the worktree when the worktree
# *is* the main checkout. `worktree` looks only in the worktree.
#
# `main` reads the file on disk, so an edit there applies to every worktree at once
# and does not have to be committed. That is the reason for the default: a worktree
# records the commit it was created at, not the branch it came from, so "the config
# as of the branch" is not something git can answer, and a config 16 commits behind
# is the normal state of a worktree nobody has merged yet.
#
# Set `worktree` to go back to each worktree using its own checked-out copy — the
# right answer when a branch legitimately changes its devcontainer.json.
WTDC_CONFIG_SOURCE=main

# Run a prebuilt image instead of the one your config declares. Either name a
# template from images/manifest.json, or point straight at an image. When set, the
# plugin drops your `features`, so the devcontainer CLI has none to apply and never
# derives a per-workspace image: `up` is just `docker run`. It says so when it drops
# them, naming each one.
#
# Blank by default: your own devcontainer.json is what runs. A template only replaces
# it when you ask for one here — a default that quietly overrode the declared image
# would make that file misleading. Set `node`, `python` or `rust` for a toolchain, or
# point WTDC_IMAGE at your own.
#
# The reason to want one at all: a config declaring any `features` makes the CLI build
# a per-workspace image, so every new worktree pays for it. A repo that declares none,
# or that names one of these images itself, is on the fast path already.
WTDC_TEMPLATE=
WTDC_IMAGE=

# remoteUser for prebuilt images. The templates ship a `dev` user.
WTDC_IMAGE_REMOTE_USER=dev

# Reuse the host herdr binary instead of downloading one per container.
# Linux hosts only. Mounts a cache copy, never the live binary.
WTDC_SHARE_HERDR_BIN=auto
