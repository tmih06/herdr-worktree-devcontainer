# worktree-devcontainer configuration.
#
# Herdr copies this file to $HERDR_PLUGIN_CONFIG_DIR/config.env on first run.
# Edit THAT copy; this file is the shipped default and is never read again
# once your own config.env exists.

# Master switch. 0 disables every event hook and action.
WTDC_ENABLED=1

# What to do when a worktree is created and it has a devcontainer config.
#   prompt  ask first, in a plugin overlay            (default)
#   auto    build the container without asking
#   never   do nothing
WTDC_ON_CREATE=prompt

# Dev Container feature that installs sshd. Herdr's saved-machine connections
# are SSH-only, so a container without an SSH server cannot become a machine.
WTDC_SSH_FEATURE=ghcr.io/devcontainers/features/sshd:1

# Container port sshd listens on. The devcontainers sshd feature uses 2222,
# not 22. Published to a random loopback host port because `devcontainer up`
# ignores forwardPorts.
WTDC_SSH_PORT=2222

# Installed inside the container during postCreateCommand, before Herdr ever
# talks to it. `herdr machine add` is a non-interactive no-op when a compatible
# binary and a running server are already present, which is the whole point of
# injecting this.
WTDC_CONTAINER_INSTALL='export PATH="$HOME/.local/bin:$PATH" && curl -fsSL https://herdr.dev/install.sh | sh'

# Name of the Herdr session running inside each container. Empty = the remote
# default session. Must match on the host side via --remote-session.
WTDC_REMOTE_SESSION=

# Create a Herdr workspace inside the container after connecting, so the
# worktree shows up under its machine in the sidebar.
WTDC_OPEN_REMOTE_WORKSPACE=1

# Seconds to wait for sshd and the container-side Herdr server to answer.
WTDC_READY_TIMEOUT=180

# Seconds to wait for `devcontainer up` to finish. First build can be slow.
WTDC_BUILD_TIMEOUT=1800

# Keep the container when the worktree is removed. 0 destroys it.
WTDC_KEEP_CONTAINER=0

# Extra bind mounts for `devcontainer up`, space separated, e.g.
#   WTDC_EXTRA_MOUNTS='type=bind,source=/tmp/x,target=/tmp/x'
# Needed if your devcontainer config uses dockerComposeFile, where runArgs
# (and therefore the SSH port publish) cannot be injected.
WTDC_EXTRA_MOUNTS=

# Paths searched for a devcontainer config, relative to the worktree.
WTDC_CONFIG_CANDIDATES='.devcontainer/devcontainer.json .devcontainer.json'

# Prefix for the machine label shown in the Herdr sidebar.
WTDC_MACHINE_LABEL_PREFIX=devc
