{
  // Dev container for developing the worktree-devcontainer plugin itself.
  //
  // Points at this project's own published image, which is what keeps a provision here
  // a `docker run` rather than an image build. The alternative — declaring
  // `ghcr.io/devcontainers/features/node:1` — makes the Dev Container CLI derive a
  // per-workspace image, so every new worktree of this repo pays ~25s before it can
  // start. The template already carries the toolchain, so there is nothing to derive.
  //
  // Multi-arch (linux/amd64 and linux/arm64) as of the image workflow's `platforms:`
  // line; see images/README.md.
  "name": "herdr-worktree-devcontainer",
  "image": "ghcr.io/tmih06/herdr-devcontainer-node:latest",

  "remoteUser": "dev",

  // Borrow host tools as individual read-only files. Use localEnv for host paths;
  // Docker does not expand a literal ~ in a mount source.
  "mounts": [
    // "type=bind,source=/usr/bin/btop,target=/usr/local/bin/btop,readonly"
    "type=bind,source=${localEnv:HOME}/.local/bin/lazygitrs,target=/usr/local/bin/lazygit,readonly",
    "type=bind,source=${localEnv:HOME}/.local/bin/codex,target=/usr/local/bin/codex,readonly"
  ],

  // The plugin waits for this command through the Dev Container CLI's waitFor setting.
  "postCreateCommand": "echo 'worktree-devcontainer dev container ready'"
}
