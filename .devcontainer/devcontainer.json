{
  // Dev container for developing the worktree-devcontainer plugin itself.
  //
  // Points at this project's own published image, which is what keeps a provision here
  // a `docker run` rather than an image build. The alternative — declaring
  // `ghcr.io/devcontainers/features/node:1` — makes the Dev Container CLI derive a
  // per-workspace image, so every new worktree of this repo pays ~25s before it can
  // start. The template already carries the toolchain, so there is nothing to derive.
  //
  // Multi-arch (linux/amd64 and linux/arm64) as of the image workflow's `platforms:`
  // line; see images/README.md.
  "name": "herdr-worktree-devcontainer",
  "image": "ghcr.io/tmih06/herdr-devcontainer-node:latest",

  "remoteUser": "dev",

  // btop, borrowed from the host rather than installed a second time in every worktree.
  //
  // Three things about this line, all of them learned by getting them wrong first.
  //
  // The *string* form of `mounts`, not the object form the spec documents first. The CLI
  // rewrites the object form down to `type`, `src` and `dst` and drops `readonly` without
  // a word — and the container user has the same uid as the host user, so without it this
  // line would hand every process in the container write access to a host binary.
  //
  // The *file*, not `/usr/bin`. A mount replaces the directory it targets rather than
  // adding to it, so `source=/usr/bin,target=/usr/bin` would take the image's own
  // /usr/local/bin content with it — including the plugin's herdr, which lives there.
  // Mounting the one file into /usr/local/bin, which is already on PATH and has no btop in
  // it, shadows nothing and has to be run by no special path.
  //
  // It only works at all because host and image agree: btop is dynamically linked, so it
  // needs the libstdc++ it was built against, and this holds because the host is Ubuntu
  // 24.04 on aarch64 and so is the image. A static binary like lazygit needs none of that;
  // a binary needing a library the image lacks would be in the container and refuse to run.
  // Add a line here per tool — there is nothing else to configure.
  "mounts": [
    "type=bind,source=/usr/bin/btop,target=/usr/local/bin/btop,readonly"
  ],

  // Nothing else is needed, and nothing is added by the plugin beyond the readiness
  // marker it appends to postCreateCommand. This file is also the proof that a user's
  // own config stays authoritative: no features, no published ports, no injected users.
  "postCreateCommand": "echo 'worktree-devcontainer dev container ready'"
}
